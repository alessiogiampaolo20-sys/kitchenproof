# KitchenProof environment variables (BLUEPRINT §17)
# Copy to .env.local and fill in. NEVER commit real values.

# ── Supabase (required from Phase 0) ────────────────────────────────────────
# Local dev: values come from `supabase start` / `supabase status`.
# Production: EU-region project (eu-central-1).
NEXT_PUBLIC_SUPABASE_URL=
# §17 "SUPABASE_ANON_KEY" — public client key, exposed to the browser.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. NEVER used in user request paths (§17); platform-admin
# endpoints double-check role and write admin_audit_log.
SUPABASE_SERVICE_ROLE_KEY=

# ── App secrets (required from Phase 0) ─────────────────────────────────────
# HMAC secret for signed actor/device cookies (PIN identity switcher).
# Generate: openssl rand -base64 32
ACTOR_SESSION_SECRET=

# ── AI — Claude API (required from Phase 4) ─────────────────────────────────
ANTHROPIC_API_KEY=

# ── Email — Resend (required from Phase 2) ──────────────────────────────────
RESEND_API_KEY=

# ── Billing — Stripe (required from Phase 8) ────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ── Web Push — VAPID (required from Phase 2) ────────────────────────────────
# Generate: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:ops@example.com
